{
  "name": "mathyu-apis",
  "version": "0.1.0",
  "description": "APIs propias de Mathyu's Solutions para couriers (Shalom, Olva) y SUNAT. Monolito modular NestJS.",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "prod": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "node --env-file=.env.prod node_modules/prisma/build/index.js migrate deploy",
    "db:status": "node --env-file=.env.prod node_modules/prisma/build/index.js migrate status",
    "key:create": "node --env-file=.env.prod scripts/api-keys.mjs create",
    "key:list": "node --env-file=.env.prod scripts/api-keys.mjs list",
    "key:revoke": "node --env-file=.env.prod scripts/api-keys.mjs revoke",
    "plan:list": "node --env-file=.env.prod scripts/plans.mjs list",
    "plan:set": "node --env-file=.env.prod scripts/plans.mjs set"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@xmldom/xmldom": "0.9.12",
    "fast-xml-parser": "5.11.1",
    "fastify": "^5.12.5",
    "fflate": "0.8.3",
    "nestjs-pino": "^5.3.1",
    "node-forge": "1.4.0",
    "pdfkit": "0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "playwright": "^1.64.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "xml-crypto": "6.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@prisma/client": "^6.19.3",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^26.6.4",
    "@types/node-forge": "1.3.14",
    "@types/pdfkit": "0.17.6",
    "@types/qrcode": "1.5.6",
    "pino-pretty": "^13.2.0",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
