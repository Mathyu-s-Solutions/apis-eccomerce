// Schema de persistencia de Mathyu's APIs (dueño único del esquema).
// El portal web (frontend/) genera su cliente Prisma desde una copia de estos
// modelos pero NUNCA corre migraciones: las migraciones salen de aquí y las
// aplica el CD del backend.

generator client {
  provider = "prisma-client-js"
  // Salida fuera de node_modules: la imagen de producción instala solo deps de
  // runtime (--ignore-scripts) y copia este cliente ya generado para Linux.
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// Cliente del portal (quien crea API keys y paga). El admin valida pagos.
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash") // legado: el login vive en Firebase
  name         String?
  role         String    @default("user") // user | admin
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  apiKeys       ApiKey[]
  payments      Payment[]
  subscriptions Subscription[]
  planUsage     PlanUsage[]
  webhook       Webhook?
  tracking      TrackingSubscription[]
  deliveries    WebhookDelivery[]
  sunatCompanies SunatCompany[]
  profile       ClientProfile?
  apiRequests   ApiRequest[]

  @@map("users")
}

model ApiKey {
  id           String         @id @default(cuid())
  // Nunca guardamos la key en claro: solo su SHA-256 (hex) y un prefijo visible.
  keyHash      String         @unique @map("key_hash")
  prefix       String
  name         String
  // API a la que da acceso la key: shalom | olva | sunat | all
  product      String         @default("all")
  // Cuota de la key solo si no tiene dueño (keys creadas a mano). Con dueño
  // manda el plan del cliente para cada API (Subscription + PlanUsage).
  monthlyLimit Int?           @map("monthly_limit") // null = ilimitado
  enabled      Boolean        @default(true)
  userId       String?        @map("user_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  counters     UsageCounter[]

  @@index([userId])
  @@map("api_keys")
}

model UsageCounter {
  id       String @id @default(cuid())
  apiKeyId String @map("api_key_id")
  period   String // YYYYMM
  used     Int    @default(0)
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, period], map: "usage_counters_api_key_id_period_key")
  @@map("usage_counters")
}

// Comprobante de pago subido por el cliente (Yape/Plin). El admin lo valida.
model Payment {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  product       String // shalom | olva | sunat
  plan          String // identificador del plan elegido
  amountPen     Int       @map("amount_pen") // monto en soles (entero)
  monthlyLimit  Int?      @map("monthly_limit") // cuota que otorga el plan
  method        String // yape_plin (antes yape | plin); el admin registra también transferencia | efectivo
  operationCode String?   @map("operation_code") // nro de operación declarado
  proofMime     String    @map("proof_mime") // "" (y proofData vacío): pago registrado a mano por el admin
  proofData     Bytes     @map("proof_data")
  // Lo que activa el pago: [{ product, plan, monthlyLimit }]. Un pack trae
  // varias APIs (product = "bundle", plan = id del pack). null en pagos antiguos.
  items         Json?
  status        String    @default("pending") // pending | approved | rejected
  note          String? // nota del admin al revisar
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("payments")
}

// Plan de un cliente en una API. Sin fila, o vencido, rige el plan gratis.
// La cuota es del plan: la comparten todas las keys del cliente para esa API.
model Subscription {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  product      String // shalom | olva | sunat
  plan         String // id del plan (frontend/src/lib/plans.ts)
  monthlyLimit Int?      @map("monthly_limit") // null = ilimitado
  expiresAt    DateTime? @map("expires_at") // null = no vence
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product])
  @@map("subscriptions")
}

// Consumo del mes de un cliente en una API (contra la cuota de su plan).
model PlanUsage {
  userId  String @map("user_id")
  product String
  period  String // YYYYMM
  used    Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, product, period])
  @@map("plan_usage")
}

// Datos del cliente que solo ve el admin: su WhatsApp (por ahí suele pagar) y notas.
model ClientProfile {
  userId    String   @id @map("user_id")
  phone     String?
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

// Webhook de una cuenta: adónde avisamos cuando cambia una guía que sigue.
model Webhook {
  userId    String   @id @map("user_id")
  url       String
  // whsec_…: firma cada entrega (HMAC-SHA256). Solo se muestra al crearla o rotarla.
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

// Guía que el worker vigila para avisar por webhook cuando cambia de estado.
model TrackingSubscription {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  product       String // shalom | olva
  orderNumber   String            @map("order_number")
  // Olva: año de emisión. Shalom: no se guarda (con la clave se retira el paquete).
  orderCode     String?           @map("order_code")
  // Shalom: ose_id (se rastrea con él, sin la clave).
  upstreamRef   String?           @map("upstream_ref")
  status        String?
  // Estado + último evento: si cambia, hay aviso.
  fingerprint   String?
  active        Boolean           @default(true)
  nextCheckAt   DateTime          @default(now()) @map("next_check_at")
  lastCheckedAt DateTime?         @map("last_checked_at")
  failures      Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@unique([userId, product, orderNumber])
  @@index([active, nextCheckAt])
  @@map("tracking_subscriptions")
}

// Cada aviso a un webhook (y sus reintentos).
model WebhookDelivery {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  subscriptionId String?               @map("subscription_id")
  event          String // tracking.updated | webhook.test
  payload        Json
  status         String                @default("pending") // pending | delivered | dead
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  lastStatus     Int?                  @map("last_status") // HTTP de la última respuesta
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   TrackingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("webhook_deliveries")
}

// Guía de Shalom ya encontrada: su ose_id, para rastrearla sin resolver otro
// captcha. Nunca se guarda la clave (con ella se retira el paquete): solo un
// hash lento (scrypt) de guía + clave.
model ShalomGuide {
  keyHash     String   @id @map("key_hash")
  oseId       String   @map("ose_id")
  transitTime String?  @map("transit_time")
  createdAt   DateTime @default(now()) @map("created_at")
  // Última vez que Shalom la encontró (no la última consulta): /status prueba con la más reciente.
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  // Shalom la encontró antes y ahora no (la quita unos días después de entregada): 404 por 6 h sin preguntarle.
  goneAt      DateTime? @map("gone_at")

  @@map("shalom_guides")
}

// Guías (guía + clave) que Shalom nunca encontró: por 2 h se responde 404 sin volver a
// preguntarle (cada búsqueda gasta captcha y del cupo por minuto). Solo el hash, como
// shalom_guides; las de más de un día se borran.
model ShalomMissingGuide {
  keyHash   String   @id @map("key_hash")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@index([checkedAt])
  @@map("shalom_missing_guides")
}

// Cuenta de Shalom Pro (pro.shalom.pe) de un cliente del portal: con ella se
// crean guías a su nombre. Una por cliente; con el plan Empresarial, varias (una
// por negocio), cada una con el identificador que elija (`ref`; "default" es la de
// PUT /shalom/pro/account). La contraseña y las cookies de la sesión van cifradas
// con SUNAT_SECRETS_KEY (AES-256-GCM): nunca en claro.
model ShalomProAccount {
  userId    String   @map("user_id")
  ref       String   @default("default")
  email     String
  password  String
  session   String?
  // Remitente que devolvió Shalom al conectar (nombre y documento, sin la clave).
  sender    Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([userId, ref])
  @@map("shalom_pro_accounts")
}

// Guías creadas por la API con Shalom Pro: el rótulo y el ticket solo se
// entregan al cliente que creó la guía (los ose_id son correlativos: así la API
// no sirve para pedir PDFs de guías ajenas).
model ShalomProShipment {
  oseId       String   @id @map("ose_id")
  userId      String   @map("user_id")
  orderNumber String   @map("order_number")
  // Cuenta con la que se creó (su `ref`): el rótulo y el ticket se piden con su sesión.
  accountRef  String   @default("default") @map("account_ref")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("shalom_pro_shipments")
}

// Envíos de Olva creados por la API (registro web de Olva, flujo de invitado):
// el rótulo solo se entrega al cliente que creó el envío.
model OlvaShipment {
  cartId      String   @id @map("cart_id")
  userId      String   @map("user_id")
  // Número de pedido de preventa de Olva.
  orderNumber String?  @map("order_number")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("olva_shipments")
}

// Correos automáticos ya enviados, para no mandar dos veces el mismo aviso
// (p. ej. "plan-expired:<subscription id>:<expiresAt>"). Lo escribe el portal.
model SentEmail {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sent_emails")
}

// Empresa emisora de un cliente en la API de SUNAT: su RUC, sus datos para el
// comprobante y las credenciales con las que se envía a SUNAT.
model SunatCompany {
  id              String   @id @default(cuid())
  userId          String   @map("user_id")
  ruc             String
  razonSocial     String   @map("razon_social")
  nombreComercial String?  @map("nombre_comercial")
  direccion       String
  ubigeo          String?
  departamento    String?
  provincia       String?
  distrito        String?
  urbanizacion    String?
  telefono        String?
  email           String?
  // Logo para el PDF (PNG o JPG).
  logo            Bytes?
  logoMime        String?  @map("logo_mime")
  // beta = pruebas contra SUNAT beta (sin validez); produccion = comprobantes reales.
  environment     String   @default("beta")
  solUser         String?  @map("sol_user")
  // Cifrados con SUNAT_SECRETS_KEY (AES-256-GCM): nunca en claro.
  solPassword     String?  @map("sol_password")
  // Llave privada + certificado en PEM, cifrados.
  certificate     String?
  // Datos visibles del certificado: sujeto, emisor, vigencia.
  certificateInfo Json?    @map("certificate_info")
  // Credenciales de API de SUNAT (menú SOL): guías de remisión, SIRE, validez.
  apiClientId     String?  @map("api_client_id")
  apiClientSecret String?  @map("api_client_secret")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       SunatDocument[]

  @@unique([userId, ruc])
  @@map("sunat_companies")
}

// Comprobante, guía, resumen o baja generado por una empresa. Guarda lo que se
// envió (XML firmado) y lo que respondió SUNAT (CDR).
model SunatDocument {
  id           String    @id @default(cuid())
  companyId    String    @map("company_id")
  environment  String // beta | produccion
  // Catálogo 01 (01, 03, 07, 08, 09, 31) o RC (resumen diario) / RA (baja).
  type         String
  series       String // F001 · RC-20261012
  number       Int
  issueDate    String    @map("issue_date") // AAAA-MM-DD
  status       String // PENDIENTE | ACEPTADO | RECHAZADO | ANULADO
  customerDoc  String?   @map("customer_doc")
  customerName String?   @map("customer_name")
  currency     String?
  total        Decimal?  @db.Decimal(14, 2)
  // DigestValue de la firma (el "valor resumen" del PDF).
  hash         String?
  // Token de las URL públicas de descarga (XML, CDR, PDF).
  token        String    @unique
  // El pedido del cliente ya validado: con él se rearma el PDF o un resumen.
  input        Json
  // ZIP con el XML firmado, tal como se envió.
  xml          Bytes
  // ZIP del CDR de SUNAT.
  cdr          Bytes?
  sunatCode    String?   @map("sunat_code")
  sunatMessage String?   @map("sunat_message")
  observations Json?
  // Resúmenes, bajas y guías: SUNAT responde después, por ticket.
  ticket       String?
  attempts     Int       @default(0)
  // Cuándo volver a preguntarle a SUNAT por un PENDIENTE.
  nextCheckAt  DateTime? @map("next_check_at")
  // Baja o resumen que lo anuló.
  voidedById   String?   @map("voided_by_id")
  // Cabecera Idempotency-Key del cliente: el mismo pedido repetido (tras un corte de red) devuelve este
  // comprobante en vez de emitir otro.
  idempotencyKey String? @map("idempotency_key")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Restrict: una empresa con comprobantes no se borra.
  company      SunatCompany @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, environment, type, series, number])
  @@unique([companyId, environment, idempotencyKey])
  @@index([status, nextCheckAt])
  @@index([companyId, createdAt])
  @@map("sunat_documents")
}

// Tipo de cambio SBS vigente en cada fecha (dólar y euro). Se guarda para no
// depender del BCRP en cada consulta: una fecha pasada ya no cambia.
model SunatExchangeRate {
  date       String // AAAA-MM-DD consultada
  currency   String // USD | EUR
  // Día de la cotización: el último hábil hasta `date`.
  quotedDate String   @map("quoted_date")
  purchase   Decimal? @db.Decimal(10, 4)
  sale       Decimal? @db.Decimal(10, 4)
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([date, currency])
  @@map("sunat_exchange_rates")
}

// Página de estado del portal (/status): el worker prueba la API y cada servicio del
// que depende cada 20 minutos (src/modules/status). Se guardan 90 días; el portal
// lee esta tabla directo, así la página funciona aunque la API esté caída.
model StatusCheck {
  // api | shalom-web | shalom-tracking | shalom-pro | olva-tracking | olva-web | sunat-cpe | sunat-beta | sunat-api | sunat-padron | sunat-exchange
  component String
  checkedAt DateTime @map("checked_at")
  status    String // up | degraded | down
  latencyMs Int?     @map("latency_ms")
  // Motivo legible y sin datos internos ("HTTP 503", "No respondió en 10 s"): se muestra en público.
  detail    String?

  @@id([component, checkedAt])
  @@index([checkedAt])
  @@map("status_checks")
}

// Registro de los requests a la API (30 días), para el panel de admin: qué endpoint llamó
// cada cliente, con qué status y qué error recibió. Sin cuerpos: llevan la clave de las
// guías de Shalom y datos de personas. Lo escribe src/common/request-log.
model ApiRequest {
  id         String   @id @default(cuid())
  // null: key sin dueño (creada a mano).
  userId     String?  @map("user_id")
  apiKeyId   String   @map("api_key_id")
  keyPrefix  String   @map("key_prefix")
  // shalom | olva | sunat (null: webhooks, cuenta…)
  product    String?
  method     String
  // La ruta con sus parámetros (/v1/shalom/shipments/:oseId/label), no la URL.
  route      String
  status     Int
  durationMs Int      @map("duration_ms")
  // Cuota que se le cobró.
  units      Int      @default(0)
  // El mensaje de error que recibió el cliente (4xx y 5xx).
  error      String?
  // Si el error vino de un courier o de SUNAT: shalom | olva | sunat…
  upstream   String?
  createdAt  DateTime @default(now()) @map("created_at")
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("api_requests")
}
