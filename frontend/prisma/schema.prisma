// COPIA del esquema que vive en backend/prisma/schema.prisma.
// El portal solo LEE/ESCRIBE; las migraciones las corre el backend (dueño del
// esquema). No ejecutar `prisma migrate` desde aquí: mantener en sync a mano.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"] // Vercel runtime
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?   @map("password_hash") // legado: el login vive en Firebase
  name         String?
  role         String    @default("user")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  apiKeys       ApiKey[]
  payments      Payment[]
  subscriptions Subscription[]
  planUsage     PlanUsage[]
  webhook       Webhook?
  tracking      TrackingSubscription[]
  deliveries    WebhookDelivery[]
  profile       ClientProfile?

  @@map("users")
}

model ApiKey {
  id           String         @id @default(cuid())
  keyHash      String         @unique @map("key_hash")
  prefix       String
  name         String
  product      String         @default("all")
  monthlyLimit Int?           @map("monthly_limit")
  enabled      Boolean        @default(true)
  userId       String?        @map("user_id")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  user         User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  counters     UsageCounter[]

  @@index([userId])
  @@map("api_keys")
}

model UsageCounter {
  id       String @id @default(cuid())
  apiKeyId String @map("api_key_id")
  period   String
  used     Int    @default(0)
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, period], map: "usage_counters_api_key_id_period_key")
  @@map("usage_counters")
}

model Payment {
  id            String    @id @default(cuid())
  userId        String    @map("user_id")
  product       String
  plan          String
  amountPen     Int       @map("amount_pen")
  monthlyLimit  Int?      @map("monthly_limit")
  method        String
  operationCode String?   @map("operation_code")
  proofMime     String    @map("proof_mime")
  proofData     Bytes     @map("proof_data")
  items         Json?
  status        String    @default("pending")
  note          String?
  reviewedBy    String?   @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([userId])
  @@map("payments")
}

model Subscription {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  product      String
  plan         String
  monthlyLimit Int?      @map("monthly_limit")
  expiresAt    DateTime? @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, product])
  @@map("subscriptions")
}

model PlanUsage {
  userId  String @map("user_id")
  product String
  period  String
  used    Int    @default(0)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, product, period])
  @@map("plan_usage")
}

// Datos del cliente que solo ve el admin: su WhatsApp (por ahí suele pagar) y notas.
model ClientProfile {
  userId    String   @id @map("user_id")
  phone     String?
  note      String?
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("client_profiles")
}

model Webhook {
  userId    String   @id @map("user_id")
  url       String
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("webhooks")
}

model TrackingSubscription {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  product       String
  orderNumber   String            @map("order_number")
  orderCode     String?           @map("order_code")
  upstreamRef   String?           @map("upstream_ref")
  status        String?
  fingerprint   String?
  active        Boolean           @default(true)
  nextCheckAt   DateTime          @default(now()) @map("next_check_at")
  lastCheckedAt DateTime?         @map("last_checked_at")
  failures      Int               @default(0)
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@unique([userId, product, orderNumber])
  @@index([active, nextCheckAt])
  @@map("tracking_subscriptions")
}

model WebhookDelivery {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  subscriptionId String?               @map("subscription_id")
  event          String
  payload        Json
  status         String                @default("pending")
  attempts       Int                   @default(0)
  nextAttemptAt  DateTime              @default(now()) @map("next_attempt_at")
  lastStatus     Int?                  @map("last_status")
  lastError      String?               @map("last_error")
  deliveredAt    DateTime?             @map("delivered_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription   TrackingSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([status, nextAttemptAt])
  @@index([userId, createdAt])
  @@map("webhook_deliveries")
}

model ShalomGuide {
  keyHash     String   @id @map("key_hash")
  oseId       String   @map("ose_id")
  transitTime String?  @map("transit_time")
  createdAt   DateTime @default(now()) @map("created_at")
  lastUsedAt  DateTime @default(now()) @map("last_used_at")
  // Shalom la encontró antes y ahora no (la quita unos días después de entregada): 404 por 6 h sin preguntarle.
  goneAt      DateTime? @map("gone_at")

  @@map("shalom_guides")
}

// Guías (guía + clave) que Shalom nunca encontró: por 2 h se responde 404 sin volver a
// preguntarle (cada búsqueda gasta captcha y del cupo por minuto). Solo el hash, como
// shalom_guides; las de más de un día se borran.
model ShalomMissingGuide {
  keyHash   String   @id @map("key_hash")
  checkedAt DateTime @default(now()) @map("checked_at")

  @@index([checkedAt])
  @@map("shalom_missing_guides")
}

model SentEmail {
  key       String   @id
  createdAt DateTime @default(now()) @map("created_at")

  @@map("sent_emails")
}

// Chequeos de la página de estado (/status): los escribe el worker del backend cada 20 min.
model StatusCheck {
  component String
  checkedAt DateTime @map("checked_at")
  status    String // up | degraded | down
  latencyMs Int?     @map("latency_ms")
  detail    String?

  @@id([component, checkedAt])
  @@index([checkedAt])
  @@map("status_checks")
}

// Registro de los requests a la API (30 días): lo escribe el backend (src/common/request-log);
// el admin lo lee en la ficha de cada cliente. Sin cuerpos.
model ApiRequest {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  apiKeyId   String   @map("api_key_id")
  keyPrefix  String   @map("key_prefix")
  product    String?
  method     String
  route      String
  status     Int
  durationMs Int      @map("duration_ms")
  units      Int      @default(0)
  error      String?
  upstream   String?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("api_requests")
}
