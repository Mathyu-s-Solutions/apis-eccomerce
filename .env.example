# === App ===
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# === Base de datos (Neon Postgres) ===
# Si se define, Auth usa Postgres (Prisma); si no, store en memoria.
# DATABASE_URL = conexión pooled (runtime). Añade ?sslmode=require&pgbouncer=true
# DIRECT_DATABASE_URL = conexión directa (migraciones), mismo host sin "-pooler".
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
# DIRECT_DATABASE_URL=postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# === Auth / API keys ===
# Con DATABASE_URL definido se usa el store de Prisma; si no, el de memoria.
DEV_API_KEY=dev-local-key
DEV_API_KEY_MONTHLY_LIMIT=100000
# Alternativa: lista completa de keys en JSON.
# API_KEYS=[{"key":"sk_cliente1","name":"Cliente 1","monthlyLimit":5000}]

# === HTTP cliente (hacia upstreams) ===
HTTP_TIMEOUT_MS=15000
HTTP_RETRIES=2

# === Olva (endpoints públicos extraídos de sus webs) ===
OLVA_WP_BASE=https://www.olvacourier.com
OLVA_TRACKING_BASE=https://reports.olvaexpress.pe
# API key pública embebida en el front de tracking de Olva. Overridable.
OLVA_TRACKING_APIKEY=a82e5d192fae9bbfee43a964024498e87dfecb884b67c7e95865a3bb07b607dd

# === Shalom (proxy web de shalom.com.pe) ===
SHALOM_WEB_BASE=https://shalom.com.pe
SHALOM_RECAPTCHA_SITEKEY=6LeGp5EtAAAAADF5427odqjDKEoxPudnerojGTt2
# Proveedor de captcha para rastrea/buscar y tarifa/mostrar: none | playwright
SHALOM_CAPTCHA_PROVIDER=none
# Opciones del proveedor Playwright (requiere: pnpm exec playwright install chromium)
SHALOM_CAPTCHA_HEADLESS=true
SHALOM_CAPTCHA_POOL_SIZE=1
SHALOM_CAPTCHA_NAV_TIMEOUT_MS=30000
SHALOM_CAPTCHA_TOKEN_TIMEOUT_MS=20000
SHALOM_CAPTCHA_PAGE_TTL_MS=600000
